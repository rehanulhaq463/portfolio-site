# Copy to .env (local) or set in your host's dashboard. Never commit real values.

# --- Contact form (server-side only; never exposed to the browser) ---
# Get an API key at https://resend.com and verify the domain you send from.
RESEND_API_KEY=''
# Where contact messages are delivered.
CONTACT_TO_EMAIL='onboarding@resend.dev'

# Sender shown on the email. Must use a domain verified in Resend,
# e.g. "Portfolio <contact@your-verified-domain>".
CONTACT_FROM_EMAIL='rehanulhaq463@gmail.com'
# Optional: extra origins allowed to POST to /api/contact, comma-separated.
# Only needed if the API is served from a different host than the site.
CONTACT_ALLOWED_ORIGINS=

# --- Site ---
# Production URL, used for canonical links and social-sharing images (build time).
SITE_URL='https://resend.com/onboarding'

# --- Server (Node adapter) ---
HOST=0.0.0.0
PORT=4321
